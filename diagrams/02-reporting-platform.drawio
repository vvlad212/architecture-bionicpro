        <mxCell id="prosthesis" value="Бионический протез&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;миодатчики + ESP32 + 4G&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="crm" value="CRM PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;клиенты и привязанные протезы&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="raw" value="ClickHouse raw telemetry&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;emg_sensor_data&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="420" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="airflow" value="Apache Airflow&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DAG bionicpro_reporting&lt;br&gt;каждый день в 00:00 UTC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="280" width="250" height="130" as="geometry"/></mxCell>
