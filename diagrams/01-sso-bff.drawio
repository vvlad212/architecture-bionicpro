<mxfile host="app.diagrams.net" modified="2026-09-14T12:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="sso-bff" name="SSO and PKCE">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="BionicPRO — SSO, PKCE и региональное хранение данных" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="Пилот протеза" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Браузер / мобильное приложение&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Только Secure HttpOnly session cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="350" width="210" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="region" value="Региональный контур BionicPRO (развёртывается в стране представительства)" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;dashed=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="1030" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="frontend" value="Web UI&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React, без OAuth-токенов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="190" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bff" value="Reports BFF / API&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Confidential OAuth client&lt;br&gt;Authorization Code + PKCE S256&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="180" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sessions" value="Redis&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;server-side sessions&lt;br&gt;access + rotating refresh token&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1190" y="170" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="keycloak" value="Keycloak Identity Broker&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PKCE обязателен, короткий access token,&lt;br&gt;refresh rotation, account linking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="390" width="310" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="idp_ru" value="Внешний IdP RU&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OIDC, расположен в РФ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1190" y="380" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="idp_other" value="Внешний IdP страны N&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OIDC/SAML адаптер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1190" y="490" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="crm" value="Региональная CRM&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PII остаётся в стране&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="660" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="medical" value="Медицинские данные&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;региональная БД / OLAP&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1070" y="660" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mapping" value="Локальная связка&lt;br&gt;external subject → customer_id&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;центрально уходит только конфигурация провайдера,&lt;br&gt;не PII и не медицинские данные&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="600" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Токены IdP никогда не попадают во frontend. BFF хранит их в Redis, обновляет на сервере и выдаёт браузеру только непрозрачный идентификатор сессии. Все соединения в production — TLS." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="810" width="880" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1. открыть UI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="user" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="browser" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. /auth/login + cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="frontend" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="4. authorize + challenge S256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="bff" target="keycloak"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="5. федерация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="keycloak" target="idp_ru"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="5. федерация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="keycloak" target="idp_other"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="6. code → token + verifier (server-to-server)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="keycloak" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="server-side tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="bff" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="customer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="keycloak" target="mapping"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="данные только своего customer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="bff" target="crm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="bff" target="medical"><mxGeometry relative="1" as="geometry"/></mxCell>
