{
  "id": "reports-realm",
  "realm": "reports-realm",
  "displayName": "BionicPRO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "BionicPRO customer"
      },
      {
        "name": "administrator",
        "description": "BionicPRO administrator"
      },
      {
        "name": "prothetic_user",
        "description": "Customer with a linked prosthesis"
      }
    ]
  },
  "clients": [
    {
      "clientId": "reports-bff",
      "name": "BionicPRO reports BFF",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "bionicpro-local-secret-change-me",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "prothetic1",
      "enabled": true,
      "email": "prothetic1@example.com",
      "emailVerified": true,
      "firstName": "Pilot",
      "lastName": "One",
      "attributes": {
        "customer_id": ["1"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "prothetic_user"]
    },
    {
      "username": "prothetic2",
      "enabled": true,
      "email": "prothetic2@example.com",
      "emailVerified": true,
      "firstName": "Pilot",
      "lastName": "Two",
      "attributes": {
        "customer_id": ["2"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "prothetic_user"]
    },
    {
      "username": "prothetic3",
      "enabled": true,
      "email": "prothetic3@example.com",
      "emailVerified": true,
      "firstName": "Pilot",
      "lastName": "Three",
      "attributes": {
        "customer_id": ["3"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "prothetic_user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["administrator"]
    }
  ],
  "identityProviders": [
    {
      "alias": "regional-idp-ru",
      "displayName": "Regional IdP — Russia",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://idp.ru.example/authorize",
        "tokenUrl": "https://idp.ru.example/token",
        "userInfoUrl": "https://idp.ru.example/userinfo",
        "jwksUrl": "https://idp.ru.example/.well-known/jwks.json",
        "clientId": "replace-at-deployment",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "regional-idp-eu",
      "displayName": "Regional IdP — European Union",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://idp.eu.example/authorize",
        "tokenUrl": "https://idp.eu.example/token",
        "userInfoUrl": "https://idp.eu.example/userinfo",
        "jwksUrl": "https://idp.eu.example/.well-known/jwks.json",
        "clientId": "replace-at-deployment",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "ru-customer-id",
      "identityProviderAlias": "regional-idp-ru",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "bionicpro_customer_id",
        "user.attribute": "customer_id",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "eu-customer-id",
      "identityProviderAlias": "regional-idp-eu",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "bionicpro_customer_id",
        "user.attribute": "customer_id",
        "syncMode": "INHERIT"
      }
    }
  ]
}
